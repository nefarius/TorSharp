<Project>
  <!--
    Microsoft.Extensions.* 11 and System.Text.Json 11 ship no net8.0 or net9.0 assets.
    The netstandard2.0 System.Text.Json 11 build then loads into VSTest and crashes the
    host (MissingMethodException on JsonObjectInfoValues<T>.set_ObjectCreator).
    Keep 10.0.14, the last release that supports those frameworks.
    net10.0 and netstandard2.0 use the central 11.x version.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Update="System.Text.Json" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.Hosting" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.Http" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.14" />
    <PackageReference Update="Microsoft.Extensions.Options" VersionOverride="10.0.14" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Nefarius.Utilities.TorProxy</AssemblyName>
    <RootNamespace>Nefarius.Utilities.TorProxy</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>

    <PackageId>Nefarius.Utilities.TorProxy</PackageId>
    <Version>$(TorProxyVersion)</Version>
    <Authors>Joel Verhagen, Nefarius</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Fork of Knapcode.TorSharp by Joel Verhagen. Use Tor for your C# HTTP clients via .NET's built-in SOCKS5 support. A Privoxy HTTP-proxy front-end remains available (opt-in) for netstandard2.0 and legacy HTTP-proxy consumers.</Description>
    <PackageProjectUrl>https://github.com/nefarius/TorSharp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2020 Joel Verhagen, © 2024-2026 Nefarius (fork contributions)</Copyright>
    <PackageTags>tor proxy http socks socks5 onion router https anonymize anonymous</PackageTags>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md at https://github.com/nefarius/TorSharp/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="ConfigureAwaitChecker.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Syndication" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <PropertyGroup>
    <BeforePack>OutputVersion</BeforePack>
  </PropertyGroup>

  <Target Name="OutputVersion">
    <Message Text="TorProxy version: $(TorProxyVersion)" Importance="high" />
  </Target>

</Project>
